# Secrets — never commit keys
.env
.env.*
!.env.example
*.key
*.pem
secrets/
my-keys.txt

# Your personal Foundation (each student fills their own; ships empty)
context/*
!context/.gitkeep
archives/*
!archives/.gitkeep
memory/*
!memory/.gitkeep
inspections/

# Node / Remotion
node_modules/
out/
.remotion/
context/signals.json
__pycache__/

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Local connector configuration may contain bearer tokens
.claude/settings*.json
.mcp.json
# Generated dashboard data
/dashboard/static/map.json

# Student-private documents and derived search index
/vault/*
!/vault/.gitkeep
/vault/documents/*
!/vault/documents/.gitkeep
/vault/context/*
!/vault/context/.gitkeep
/vault/index.jsonl
/imports/raw/
