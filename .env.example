# .env.example — copy this file to .env and fill in only what you have.
# NEVER commit .env. NEVER paste keys into chat or into markdown files.
# Load into a shell with:  set -a && . ./.env && set +a

# Day 3 — free, console.groq.com (scores news, transcribes voice notes)
GROQ_API_KEY=

# Day 6 — free, from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (the bridge tells you this on first message)
TELEGRAM_CHAT_ID=

# Day 5 — free tier, composio.dev (Gmail/Calendar/Drive connection)
COMPOSIO_API_KEY=

# Day 4 — free tier, resend.com (newsletter sending)
RESEND_API_KEY=

# Optional — elevenlabs.io. NOTE: free tier is NON-COMMERCIAL only;
# business use requires the $6/mo Starter plan.
ELEVENLABS_API_KEY=

# Optional — console.anthropic.com. Recommended for SCHEDULED/unattended
# jobs (Day 7): Anthropic's consumer terms don't cover bot/script access
# on a Pro subscription; the API is the sanctioned path.
ANTHROPIC_API_KEY=
