# .env.example — copy this file to .env and fill in only what you have.
# NEVER commit .env. NEVER paste keys into chat or into markdown files.
# Load into a shell with:  set -a && . ./.env && set +a
#
# On a server this file lives at /opt/aios/.env, chmod 600, owned by aios.

# ---------------------------------------------------------------------------
# THE BRAIN IS NOT IN THIS FILE.
#
# Claude is authenticated with a SUBSCRIPTION, not a key. On the server, run:
#     claude setup-token
# It prints a link, you approve it on your phone, you paste the code back.
# That token belongs to Claude Code; nothing here reads it.
#
# There is deliberately no ANTHROPIC_API_KEY below, and you should not add one.
# Per-token billing on a system that runs all day is how people spend $300 in a
# weekend. The installer refuses to run if ANTHROPIC_API_KEY is set.
# See BUILD 0 of IMPLEMENTATION-PLAN.md.
# ---------------------------------------------------------------------------

# Day 6 — free, console.groq.com (transcribes your voice notes)
GROQ_API_KEY=

# Day 6 — free, from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (the bridge tells you this on first message)
TELEGRAM_CHAT_ID=

# Day 5 — free tier, composio.dev (Gmail/Calendar/Drive connection)
COMPOSIO_API_KEY=

# Day 4 — free tier, resend.com (newsletter sending)
RESEND_API_KEY=

# Day 0 — the dashboard password. The dashboard refuses to start without it.
DASHBOARD_PASSWORD=

# Day 6, optional — elevenlabs.io, so it talks back in a real voice.
# NOTE: the free tier is NON-COMMERCIAL only; business use needs the $6/mo plan.
# Leave blank and everything still works, in text.
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Optional tentacles — add only the ones you actually use. Day 5 and after.
BLOTATO_API_KEY=
SOCIALCLAW_API_KEY=
MANYCHAT_API_KEY=

# Optional — where the local model listens, for free document search (Tier 1).
# Leave blank and vault search falls back to keyword matching. Not a credential:
# this is a loopback address. If Tier 1 ever needs a key, something is wrong.
AIOS_LOCAL_MODEL_URL=
