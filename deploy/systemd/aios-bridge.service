[Unit]
Description=AIOS Telegram bridge
After=network-online.target

[Service]
User=aios
WorkingDirectory=/opt/aios/app
EnvironmentFile=/opt/aios/.env
EnvironmentFile=-/opt/bot/.env
EnvironmentFile=-/opt/bot/token.env
EnvironmentFile=-/opt/firehose-system/.env
ExecStart=/opt/aios/venv/bin/python scripts/bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
